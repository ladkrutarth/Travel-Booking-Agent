# App
APP_ENV=development
KILL_SWITCH=false
MAX_AGENT_STEPS=12
MAX_TRIP_COST_USD=0.50
AGENT_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
JWT_SECRET=dev-change-me-travel-booking-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROPOSAL_TTL_MINUTES=30

# Database (SQLite for local; Postgres for production)
DATABASE_URL=sqlite:///./travel_agent.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/travel_agent

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_EXTRACTION_MODEL=gpt-4o-mini

# Amadeus (sandbox: test.api.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
AMADEUS_MOCK=true
FLIGHT_SOURCES=mock

# OpenWeather
OPENWEATHER_API_KEY=
OPENWEATHER_MOCK=true

# Google Places
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MOCK=true

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-booking-agent

# Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
